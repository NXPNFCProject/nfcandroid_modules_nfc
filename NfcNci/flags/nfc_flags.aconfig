package: "com.android.nfc.flags"
container: "system"

flag {
    name: "test_flag"
    namespace: "nfc"
    description: "Test flag for NFC"
    bug: "295339053"
}

flag {
    name: "statsd_ce_events_flag"
    namespace: "nfc"
    description: "Additional Statsd CardEmulation Events flag for NFC"
    bug: "308094195"
}


flag {
    name: "auto_disable_observe_mode"
    namespace: "nfc"
    description: "Automatically disable observe mode if preferred service is misbehaving"
    bug: "347728416"
        metadata {
        purpose: PURPOSE_BUGFIX
  }
}

flag {
    name: "observe_mode_without_rf"
    namespace: "nfc"
    description: "Enable setting obseve mode state with out deactivating RF"
    bug: "368655283"
}

flag {
    name: "post_callbacks"
    namespace: "nfc"
    description: "Post callbacks to CardEmulationManager to handler to get off of NFC callback thread."
    bug: "370015438"
}

flag {
    name: "ee_aid_select"
    namespace: "nfc"
    description: "Propigate NFA_EE_ACTION_EVT->NFC_EE_TRIG_SELECT up to onOffHostAidSelected()"
    bug: "323440961"
}

# TODO (b/460625807) workaround to move un-exported flags from com.android.nfc.module.flags to
# com.android.nfc.flags
flag {
    name: "coalesce_rf_field_on_off_broadcasts"
    namespace: "nfc"
    description: "Set delivery group policy to coalesce RF field on/off broadcasts."
    bug: "447360447"
    metadata {
        purpose: PURPOSE_BUGFIX
    }
}

flag {
    name: "foreground_app_package_name_matching"
    namespace: "nfc"
    description: "Use package name instead of component name for foreground app matching."
    bug: "433127912"
}

# Don't add any new flags for Android 16+ targeting features. Use the flags
# in com.android.nfc.module.flags (packages/modules/Nfc/flags) instead.
